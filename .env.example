APP_NAME=Thinkback
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# 中文注释：项目数据库名统一为 liaoriver_memory；生产环境只替换主机、账号和密钥。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=liaoriver_memory

# 中文注释：Redis 当前用于 readiness 和运行时缓存，不再承担 Celery broker/result backend。
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 中文注释：生产环境使用平台提供的独立 Qdrant；Thinkback 只通过 Mem0 Library 访问它。
QDRANT_URL=https://qdrant.example.internal
QDRANT_API_KEY=

# 中文注释：OpenAI 兼容模型负责抽取和 embedding；生产默认 L3 异步写入。
OPENAI_API_KEY=
MEMORY_OPENAI_BASE_URL=
MEMORY_QDRANT_COLLECTION=memories_qwen_1024
MEMORY_EMBEDDING_DIMS=1024
MEMORY_LLM_MODEL=qwen3.5-flash
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEM0_HISTORY_DB_PATH=.mem0/history.db

# 中文注释：async 是生产默认值；本地需要写后立即召回时可改成 sync。
MEMORY_L3_WRITE_MODE=async
MEMORY_API_WORKER_LIMIT=8
MEMORY_L3_EXECUTOR_WORKERS=16
MEMORY_L3_MAX_PENDING_TASKS=256
MEMORY_L3_QUEUE_WAIT_SECONDS=5
READINESS_TIMEOUT_SECONDS=30
