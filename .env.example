# 中文注释：应用名称，只用于日志和服务标识，本地一般不用改。
APP_NAME=Thinkback
# 中文注释：应用版本，只用于日志、健康检查或发布标识。
APP_VERSION=0.1.0
# 中文注释：运行环境标识，本地使用 development，生产由 K8s ConfigMap 设置为 production。
ENVIRONMENT=development
# 中文注释：是否打开调试模式，本地可为 true，生产必须关闭。
DEBUG=true
# 中文注释：日志级别，本地调试用 DEBUG，生产建议 INFO。
LOG_LEVEL=DEBUG

# 中文注释：本地控制台启动 API 监听地址，默认只监听本机。
API_HOST=127.0.0.1
# 中文注释：本地控制台启动 API 监听端口，避免占用常见 8000 端口。
API_PORT=18082
# 中文注释：脚本访问 Thinkback API 的地址，真实质量评测和压测脚本会读取它。
THINKBACK_API_URL=http://127.0.0.1:18082

# 中文注释：唯一环境模板；本地调试可直接复制为 .env，生产环境以 k8s/ConfigMap 和 Secret 为准。
# 中文注释：PostgreSQL 主机名；控制台本地调试用 localhost，Compose app 容器会覆盖为 postgres。
POSTGRES_HOST=localhost
# 中文注释：PostgreSQL 端口；控制台本地调试使用宿主机暴露端口。
POSTGRES_PORT=5432
# 中文注释：PostgreSQL 用户名；本地默认与 docker-compose.yml 对齐。
POSTGRES_USER=postgres
# 中文注释：PostgreSQL 密码；本地如有自建密码，在 .env 中覆盖示例值。
POSTGRES_PASSWORD=postgres
# 中文注释：项目数据库名统一为 liaoriver_memory，避免与旧 thinkback 库混用。
POSTGRES_DATABASE=liaoriver_memory

# 中文注释：Redis 主机名；控制台本地调试用 localhost，Compose app 容器会覆盖为 redis。
REDIS_HOST=localhost
# 中文注释：Redis 端口；控制台本地调试使用宿主机暴露端口。
REDIS_PORT=6379
# 中文注释：Redis DB 编号；首版默认使用 0。
REDIS_DB=0
# 中文注释：Redis 密码；本地 Docker Redis 默认无密码。
REDIS_PASSWORD=

# 中文注释：Qdrant 地址；本地调试默认连接本机，生产应改为平台提供的独立向量库地址。
QDRANT_URL=http://localhost:6333
# 中文注释：Qdrant API key；本地无鉴权可留空，生产远端 Qdrant 应配置。
QDRANT_API_KEY=

# 中文注释：模型服务密钥；OpenAI 和 OpenAI-compatible endpoint 都统一使用这个变量。
OPENAI_API_KEY=
# 中文注释：OpenAI-compatible endpoint 的 base URL；直接使用 OpenAI 官方 endpoint 时可留空。
MEMORY_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 中文注释：Mem0 写入 Qdrant 的集合名；维度变化时应新建集合，避免混用旧向量。
MEMORY_QDRANT_COLLECTION=memories_qwen_1024
# 中文注释：Embedding 向量维度，必须与 MEMORY_EMBEDDING_MODEL 实际输出一致。
MEMORY_EMBEDDING_DIMS=1024
# 中文注释：Mem0 抽取记忆使用的 LLM 模型名。
MEMORY_LLM_MODEL=qwen3.5-flash
# 中文注释：Mem0 生成向量使用的 Embedding 模型名。
MEMORY_EMBEDDING_MODEL=text-embedding-v4
# 中文注释：Mem0 Library 的本地历史数据库路径；容器内需要挂载到可写目录。
MEM0_HISTORY_DB_PATH=.mem0/history.db

# 中文注释：L3 写入模式；本地调试用 sync 便于 append 后马上 recall，生产建议 async。
MEMORY_L3_WRITE_MODE=sync
# 中文注释：API 同步路由进入线程池的并发上限。
MEMORY_API_WORKER_LIMIT=8
# 中文注释：L3 后台抽取线程数，影响 Mem0 写入并发。
MEMORY_L3_EXECUTOR_WORKERS=16
# 中文注释：L3 后台写入队列容量，队列满时会触发背压。
MEMORY_L3_MAX_PENDING_TASKS=256
# 中文注释：队列接近满时最多等待秒数，超过后返回明确错误。
MEMORY_L3_QUEUE_WAIT_SECONDS=5
# 中文注释：/health/ready 单项依赖检查超时时间，单位秒。
READINESS_TIMEOUT_SECONDS=30

# 中文注释：真实质量评测总超时；外部模型或 Mem0 卡住时自动生成失败报告，不无限挂起。
QUALITY_EVALUATION_TIMEOUT_SECONDS=900
