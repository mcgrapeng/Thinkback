# 应用基础配置
# 应用名称，日志、健康检查和部署识别使用。
APP_NAME=thinkback
# 应用版本，应与镜像版本或发布版本保持一致。
APP_VERSION=0.1.0
# 运行环境，本地使用 development，生产使用 production。
ENVIRONMENT=development
# 是否开启调试模式，生产必须为 false。
DEBUG=true
# 日志级别，常用 INFO，排障时可临时改为 DEBUG。
LOG_LEVEL=DEBUG

# PostgreSQL 数据库配置
# 数据库连接 URL（优先使用此配置）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thinkback
# PostgreSQL 主机地址，本地通常是 localhost。
# POSTGRES_HOST=localhost
# PostgreSQL 端口，本地默认 5432。
# POSTGRES_PORT=5432
# PostgreSQL 用户名。
# POSTGRES_USER=postgres
# PostgreSQL 密码；本地按实际共享或 compose 环境填写，生产必须走 Secret。
# POSTGRES_PASSWORD=<local-postgres-password>
# PostgreSQL 数据库名，当前固定为 thinkback。
# POSTGRES_DATABASE=thinkback

# 说明：短期记忆（L1 轮次缓存 / L2 会话摘要）只落 PostgreSQL；
# 服务已移除 Redis 与 Celery 依赖，不再有任何缓存层配置。

# Milvus 向量库配置
# Milvus 由外部独立部署，服务只通过地址、数据库和认证信息连接。
# Milvus 服务地址，本地可用 localhost，生产必须使用真实服务地址。
MILVUS_URL=http://localhost:19530
# Milvus database 名称。
MILVUS_DATABASE=default
# Milvus 用户名，无鉴权时留空。
MILVUS_USER=
# Milvus 密码，无鉴权时留空。
MILVUS_PASSWORD=

# LLM 和 Embedding 配置
# Mem0 Library 在 thinkback 进程内运行；LLM 使用 OpenAI-compatible 接口做记忆抽取。
# Embedding 使用独立 OpenAI-compatible 服务。
# LLM 与 Embedding 的鉴权 key 各自独立且可选：端点无需鉴权时留空即可。
#
# LLM API key（可选）。生产必须通过 Secret 注入。
MEMORY_LLM_KEY=
# OpenAI-compatible LLM endpoint 地址。
MEMORY_LLM_BASE_URL=
# OpenAI-compatible Embedding endpoint 地址。
MEMORY_EMBEDDING_BASE_URL=
# Embedding API key（可选），endpoint 不需要鉴权时留空。
MEMORY_EMBEDDING_API_KEY=
# Mem0 写入 Milvus 的 collection 名称。
# 集合由 Thinkback 预建（见 script/migrate_milvus_collection.py），不要手工建。
MEMORY_MILVUS_COLLECTION=thinkback
# Milvus ``text`` 字段的分析器。chinese 才能让中文 BM25 生效；
# 集合已存在且分析器不同时 Milvus 不允许原地改，只能迁移重建。
MEMORY_MILVUS_ANALYZER=chinese
# 迁移窗口的次集合（双写 + 双读回落）。留空表示没有迁移在窗口内。
# 回滚：把它清掉、把 MEMORY_MILVUS_COLLECTION 改回旧集合名。
MEMORY_MILVUS_MIRROR_COLLECTION=
# 保留期物理清理作业（ADR-0010 第三段）。默认关闭：开了就要有 CronJob 或
# 人工定期跑 script/run_retention_cleanup.py。
MEMORY_RETENTION_ENABLED=false
# 到期后再等几天才物理删除：让「用户改口」能挽回。
MEMORY_RETENTION_GRACE_DAYS=7
MEMORY_RETENTION_BATCH_SIZE=500
# 只清某个 namespace；留空表示全部。
MEMORY_RETENTION_NAMESPACE=
# 部署形态。单副本是当前的发布边界；宣称多副本但前置没齐时，服务在启动期
# 硬失败（见 docs/DEPLOYMENT.md 的 replicas 说明）。
MEMORY_MULTI_REPLICA=false
# 进程内 L1 缓存。多副本部署必须关（关掉后走读穿透，每次回源 PG）。
MEMORY_L1_CACHE_ENABLED=true
# mem0 的 history.db 是否在共享卷上（多副本部署必须共享）。
MEMORY_HISTORY_DB_SHARED=false
# Embedding 向量维度，必须与 embedding 服务输出一致。
MEMORY_EMBEDDING_DIMS=1024
# LLM 模型名称。
MEMORY_LLM_MODEL=
# Embedding 模型名称。
MEMORY_EMBEDDING_MODEL=

# 记忆服务运行参数
# Mem0 Library 本地历史数据库路径，需要进程可写。
MEM0_HISTORY_DB_PATH=.mem0/history.db
# L3 写入模式，async 表示后台抽取长期记忆。
MEMORY_L3_WRITE_MODE=async
# API 同步工作线程并发上限。
MEMORY_API_WORKER_LIMIT=8
# API 同步工作进入 worker 并等待返回的总时间窗口，单位秒。
MEMORY_API_WORKER_WAIT_SECONDS=5
# L3 后台抽取线程数。
MEMORY_L3_EXECUTOR_WORKERS=16
# L3 后台写入队列容量。
MEMORY_L3_MAX_PENDING_TASKS=256
# L3 队列满前的最长等待秒数。
MEMORY_L3_QUEUE_WAIT_SECONDS=5
# Mem0 Library 后端调用并发上限，读写分开两把信号量。
# 数值按 Little's Law 定（并发 = 目标吞吐 × 单次服务时间）：
# 写路径打 LLM 抽取（慢，约 2.5s/次），读路径只要 embedding + 向量检索
# （快，约 0.3s/次）—— service time 差一个量级，用同一个数限会有一边饿死。
MEMORY_BACKEND_MAX_CONCURRENT_WRITES=4
MEMORY_BACKEND_MAX_CONCURRENT_READS=8
# P0 本地索引白名单：控制 mem0 抽出的 L3 事件是否进本地 MemoryRecord。
# 留空 = 全部接受，/items 与 /recall 看得到所有 L3 记忆。默认行为。
# 非空 = 只接受列出的 slot，例如：
#   MEMORY_P0_SLOTS=preferred_nickname,pet_name:cat,current_location
# ⚠️ 未列入的 slot 仍写入 mem0，但不会进入 /recall 召回结果（recall 只返回
# 本地索引 ACTIVE 记忆），在向量库中属于不可召回的存量数据。
MEMORY_P0_SLOTS=
# 受信调用方身份头（D1 接入层身份绑定）。空 = 不启用（内网信任边界 = 网络边界，
# D10）。非空 = 网关注入该 HTTP 头 / gRPC metadata（键小写），/v2/memory/* 里
# 调用方自报的 user_id 必须与之完全一致，头缺失或不一致一律 403 /
# PERMISSION_DENIED。例：TRUSTED_USER_HEADER=X-User-Id
TRUSTED_USER_HEADER=

# gRPC 服务配置
# 是否启用内嵌 gRPC 服务（HTTP 面始终可用）。
GRPC_ENABLED=true
# gRPC 监听地址。0.0.0.0 = 监听所有网卡；只用本机改成 127.0.0.1。
GRPC_HOST=0.0.0.0
# gRPC 监听端口，避免与其他服务冲突（如 another-service 默认 50051）。
GRPC_PORT=50051
# gRPC 线程池大小（处理并发 RPC 的工作线程数）。
GRPC_MAX_WORKERS=8
# 单个 RPC 的最大并发数，0 = 不限。设了值可防单个调用方打满线程池。
GRPC_MAX_CONCURRENT_RPCS=0
# 优雅关停的等待秒数：收到 SIGTERM 后等在途请求做完再退出。
GRPC_SHUTDOWN_GRACE_SECONDS=5

# 管理台 CORS
# 允许访问管理台 API 的来源，逗号分隔。留空 = 不额外限制。
# 生产按实际管理台域名填，不要用 "*"（带凭据的请求不允许通配来源）。
ADMIN_CORS_ALLOW_ORIGINS=

# 限流（按调用方身份分桶）
# 每分钟允许的请求数。超出返回 429。
MEMORY_RATE_LIMIT_PER_MINUTE=600
# 突发额度：允许瞬间超过每分钟限额的量（令牌桶的桶容量）。
MEMORY_RATE_LIMIT_BURST=50

# 记忆类型注册表 profile 目录（逗号分隔，按顺序找第一个命中的）。
# 第一个是企业自己的 profile 挂载点，第二个是镜像内置的（/app/profiles）。
# 企业新增记忆类型只改挂载点里的文件，不必重建镜像。
MEMORY_TYPE_PROFILE_DIR=profiles
# 本部署服务的 namespace 白名单（逗号分隔），留空 = 不限制。
# 一个部署服务一个租户时填上它：名单外的 namespace 一律 403 / PERMISSION_DENIED，
# MCP 侧直接拒绝启动（docs/API.md 信任模型）。
MEMORY_ALLOWED_NAMESPACES=

# 记忆抽取开关
# mem0.add() 是否走 LLM 事实抽取（要 chat/completions endpoint）。
# 设为 false 时退化为纯向量存储：raw message 落地为一条记忆，
# thinkback 的 P0 槽位逻辑负责结构化抽取。
# 适用场景：embedding-only endpoint、LLM 暂不可用、生产灰度观察。
MEMORY_INFER_FACTS=true

# L2 摘要由 LLM 生成
# 关闭时 L2 摘录用规则拼（首轮 + 最近轮次），不调 LLM。
MEMORY_L2_LLM_ENABLED=true
# 每隔多少轮重新生成一次 L2 摘要。
MEMORY_L2_REFRESH_INTERVAL_ROUNDS=5
# L2 摘要的单次 LLM 超时秒数。
MEMORY_L2_LLM_TIMEOUT_SECONDS=30
# L2 摘要的 token 上限（超了截断）。
MEMORY_L2_LLM_MAX_TOKENS=512

# 记忆衰减（长期不用的事实慢慢淡出）
# 默认关闭；开了要有定时任务驱动。
MEMORY_DECAY_ENABLED=false
# 事实至少存在多少天才进入衰减候选（天）。
MEMORY_DECAY_MIN_AGE_DAYS=90
# 多少天没被召回过就开始衰减（天）。
MEMORY_DECAY_UNRECALLED_DAYS=60
# 衰减扫描的间隔秒数。
MEMORY_DECAY_SWEEP_INTERVAL_SECONDS=3600

# 就绪检查配置
# 单个依赖 readiness 检查超时时间，单位秒。
READINESS_TIMEOUT_SECONDS=3

# 任务恢复配置
# 孤儿 running 任务回收阈值（秒）：服务启动时把超过该时长无更新的
# running 任务回收为 failed（进程被硬杀留下的孤儿，否则 GetTask 永远 running）。
# 必须显著大于最长后台任务时长（L3 抽取分钟级）；最小允许 60。
TASK_ORPHAN_RUNNING_SECONDS=1800

# ── 工具链变量（不是服务配置）────────────────────────────────────────────
#
# 下面这些由**脚本/前端**直接读 os.environ，不经 Settings。它们放这里是为了
# 「所有环境变量在一处可见」—— 运维不用翻源码才知道有哪些旋钮。
#
# 本地启动脚本（script/dev.py）
# 后端端口；默认 7002，被占用时顺延。
BACKEND_PORT=7002
# 管理台（vite）端口；默认 7001，被占用时 vite 自动顺延。
FRONTEND_PORT=7001
# 管理台是否走 mock 数据（1 = 走 mock，不连后端）。前端构建时读。
VITE_USE_MOCK=0
# 管理台代理的后端地址（VITE_USE_MOCK=0 时生效）。
VITE_API_TARGET=http://localhost:7002

# MCP 客户端（src/thinkback/mcp/__main__.py）
# MCP 服务的 namespace。
THINKBACK_MCP_NAMESPACE=thinkback
# MCP 绑定的调用方 user_id（留空 = 不绑定）。
THINKBACK_MCP_USER_ID=
# 传输方式：stdio 或 sse。
THINKBACK_MCP_TRANSPORT=stdio
# sse 传输时的监听地址与端口。
THINKBACK_MCP_HOST=127.0.0.1
THINKBACK_MCP_PORT=8765
# 是否允许未鉴权访问 MCP（仅本地调试用；生产必须留空）。
THINKBACK_MCP_ALLOW_UNAUTHENTICATED=

# 真实栈脚本（tests/script/realchain/）驱动**运行中**的服务时用
# 真实栈门禁与压测脚本（tests/script/real_mem0_*.py）通过 HTTP 驱动服务，
# 需要知道服务在哪。
# 运行中服务的地址。
THINKBACK_MEMORY_API_URL=http://127.0.0.1:8000
#
# 服务端**没有** API key 鉴权（HTTP 与 gRPC 面都没有挂鉴权中间件；
# 信任边界是网络边界 —— k8s NetworkPolicy + 内网暴露）。
# 所以这里没有「调用服务所需的 key」这一项：曾经有个 THINKBACK_API_KEY，
# 但服务端根本不校验它 —— 填了没用，不填又跑不起来，两头都错。
