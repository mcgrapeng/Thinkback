APP_NAME=Thinkback
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=thinkback

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Shared, independently deployed Qdrant.
# Thinkback uses this endpoint only for readiness diagnostics.
# Mem0 must point to the same Qdrant endpoint for L3 vector storage.
QDRANT_URL=https://qdrant.example.internal
QDRANT_API_KEY=

# Thinkback calls an independently deployed Mem0 REST API.
# Mem0 owns L3 extraction, embedding, vector writes, semantic search, update, and delete.
MEM0_API_URL=https://mem0.example.internal
MEM0_API_KEY=
MEM0_HTTP_TIMEOUT_SECONDS=120
