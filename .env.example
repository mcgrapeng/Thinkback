# 应用基础配置
# 应用名称，日志、健康检查和部署识别使用。
APP_NAME=thinkback
# 应用版本，应与镜像版本或发布版本保持一致。
APP_VERSION=0.1.0
# 运行环境，本地使用 development，生产使用 production。
ENVIRONMENT=development
# 是否开启调试模式，生产必须为 false。
DEBUG=true
# 日志级别，常用 INFO，排障时可临时改为 DEBUG。
LOG_LEVEL=DEBUG

# PostgreSQL 数据库配置
# 数据库连接 URL（优先使用此配置）
DATABASE_URL=postgres://postgres:postgres@localhost:5432/thinkback
# PostgreSQL 主机地址，本地通常是 localhost。
# POSTGRES_HOST=localhost
# PostgreSQL 端口，本地默认 5432。
# POSTGRES_PORT=5432
# PostgreSQL 用户名。
# POSTGRES_USER=postgres
# PostgreSQL 密码；本地按实际共享或 compose 环境填写，生产必须走 Secret。
# POSTGRES_PASSWORD=<local-postgres-password>
# PostgreSQL 数据库名，当前固定为 thinkback。
# POSTGRES_DATABASE=thinkback

# 说明：短期记忆（L1 轮次缓存 / L2 会话摘要）只落 PostgreSQL；
# 服务已移除 Redis 与 Celery 依赖，不再有任何缓存层配置。

# Milvus 向量库配置
# Milvus 由外部独立部署，服务只通过地址、数据库和认证信息连接。
# Milvus 服务地址，本地可用 localhost，生产必须使用真实服务地址。
MILVUS_URL=http://localhost:19530
# Milvus database 名称。
MILVUS_DATABASE=default
# Milvus 用户名，无鉴权时留空。
MILVUS_USER=
# Milvus 密码，无鉴权时留空。
MILVUS_PASSWORD=

# LLM 和 Embedding 配置
# Mem0 Library 在 thinkback 进程内运行；LLM 使用 OpenAI-compatible 接口做记忆抽取。
# Embedding 使用独立 OpenAI-compatible 服务。
# LLM 与 Embedding 的鉴权 key 各自独立且可选：端点无需鉴权时留空即可。
#
# LLM API key（可选）。生产必须通过 Secret 注入。
MEMORY_LLM_KEY=
# OpenAI-compatible LLM endpoint 地址。
MEMORY_LLM_BASE_URL=
# OpenAI-compatible Embedding endpoint 地址。
MEMORY_EMBEDDING_BASE_URL=
# Embedding API key（可选），endpoint 不需要鉴权时留空。
MEMORY_EMBEDDING_API_KEY=
# Mem0 写入 Milvus 的 collection 名称。
MEMORY_MILVUS_COLLECTION=thinkback
# Embedding 向量维度，必须与 embedding 服务输出一致。
MEMORY_EMBEDDING_DIMS=1024
# LLM 模型名称。
MEMORY_LLM_MODEL=
# Embedding 模型名称。
MEMORY_EMBEDDING_MODEL=

# 记忆服务运行参数
# Mem0 Library 本地历史数据库路径，需要进程可写。
MEM0_HISTORY_DB_PATH=.mem0/history.db
# L3 写入模式，async 表示后台抽取长期记忆。
MEMORY_L3_WRITE_MODE=async
# API 同步工作线程并发上限。
MEMORY_API_WORKER_LIMIT=8
# API 同步工作进入 worker 并等待返回的总时间窗口，单位秒。
MEMORY_API_WORKER_WAIT_SECONDS=5
# L3 后台抽取线程数。
MEMORY_L3_EXECUTOR_WORKERS=16
# L3 后台写入队列容量。
MEMORY_L3_MAX_PENDING_TASKS=256
# L3 队列满前的最长等待秒数。
MEMORY_L3_QUEUE_WAIT_SECONDS=5
# Mem0 Library 后端调用并发上限。
MEMORY_BACKEND_MAX_CONCURRENT_CALLS=4
# P0 本地索引白名单：控制 mem0 抽出的 L3 事件是否进本地 MemoryRecord。
# 留空 = 全部接受，/items 与 /recall 看得到所有 L3 记忆。默认行为。
# 非空 = 只接受列出的 slot，例如：
#   MEMORY_P0_SLOTS=preferred_nickname,pet_name:cat,current_location
# ⚠️ 未列入的 slot 仍写入 mem0，但不会进入 /recall 召回结果（recall 只返回
# 本地索引 ACTIVE 记忆），在向量库中属于不可召回的存量数据。
MEMORY_P0_SLOTS=

# gRPC 服务配置
# gRPC 监听端口，避免与其他服务冲突（如 another-service 默认 50051）。
GRPC_PORT=50052

# 就绪检查配置
# 单个依赖 readiness 检查超时时间，单位秒。
READINESS_TIMEOUT_SECONDS=3

# 任务恢复配置
# 孤儿 running 任务回收阈值（秒）：服务启动时把超过该时长无更新的
# running 任务回收为 failed（进程被硬杀留下的孤儿，否则 GetTask 永远 running）。
# 必须显著大于最长后台任务时长（L3 抽取分钟级）；最小允许 60。
TASK_ORPHAN_RUNNING_SECONDS=1800
