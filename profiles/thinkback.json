    },
    "plan": {
      "extractor": "mem0",
      "source_roles": ["user"],
      "conflict": "overwrite",
      "retention": "forever",
      "classification": "personal",
      "extraction_prompt": "prompts/thinkback/plan.v1.md",
      "description": "计划与目标"
    },
    "constraint": {
      "extractor": "mem0",
      "source_roles": ["user"],
      "conflict": "overwrite",
      "retention": "forever",
      "classification": "personal",
      "extraction_prompt": "prompts/thinkback/constraint.v1.md",
      "description": "约束与雷区（属用户事实，不是程序性规则）"
