{
  "namespace": "thinkback",
  "version": "1",
  "types": {
    "profile": {
      "extractor": "mem0",
      "source_roles": ["user"],
      "conflict": "overwrite",
      "retention": "forever",
      "classification": "personal",
      "extraction_prompt": "prompts/thinkback/profile.v1.md",
      "description": "用户画像：称呼、偏好、稳定的长期事实"
    },
    "preference": {
      "extractor": "mem0",
      "source_roles": ["user"],
      "conflict": "overwrite",
      "retention": "forever",
      "classification": "personal",
      "extraction_prompt": "prompts/thinkback/preference.v1.md",
      "description": "偏好与习惯"
    },
    "event": {
      "extractor": "mem0",
      "source_roles": ["user", "tool"],
      "conflict": "append",
      "retention": "forever",
      "classification": "personal",
      "description": "已发生的事件与叙事"
    },
    "state": {
      "extractor": "mem0",
      "source_roles": ["user", "tool"],
      "conflict": "overwrite",
      "retention": "ttl",
