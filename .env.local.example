APP_NAME=Thinkback
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

API_HOST=127.0.0.1
API_PORT=18082
THINKBACK_API_URL=http://127.0.0.1:18082

# 中文注释：本地真实链路默认使用当前工程约定的数据库，避免误连 thinkback 默认库。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=zpeng512
POSTGRES_DATABASE=liaoriver_memory

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=zpeng512

# 中文注释：本地调试默认连接本机 Qdrant；生产配置见 k8s/configmap.yaml。
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 中文注释：使用 OpenAI-compatible endpoint 时填写 base URL；OPENAI_API_KEY 仍用同一个变量。
OPENAI_API_KEY=
MEMORY_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MEMORY_QDRANT_COLLECTION=memories_qwen_1024
MEMORY_EMBEDDING_DIMS=1024
MEMORY_LLM_MODEL=qwen3.5-flash
MEMORY_EMBEDDING_MODEL=text-embedding-v4
MEM0_HISTORY_DB_PATH=.mem0/history.db

# 本地调试用 sync，便于 append 后马上 recall；生产仍建议 async。
MEMORY_L3_WRITE_MODE=sync
MEMORY_API_WORKER_LIMIT=8
MEMORY_L3_EXECUTOR_WORKERS=16
MEMORY_L3_MAX_PENDING_TASKS=256
MEMORY_L3_QUEUE_WAIT_SECONDS=5
READINESS_TIMEOUT_SECONDS=30
